{
  "name": "@mano8/astro-media-m8",
  "version": "1.2.0",
  "description": "Astro integration and headless client for media-service-m8.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mano8/astro-media-m8.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "astro-integration",
    "astro",
    "media",
    "uploads",
    "media-service-m8"
  ],
  "files": [
    "dist",
    "src/routes",
    "src/scaffold/styles",
    "registry.json",
    "registry/r",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/src/integration.js",
    "./api": "./dist/src/runtime/api/index.js",
    "./client": "./dist/src/runtime/client.js",
    "./schemas": "./dist/src/runtime/schemas.js",
    "./auth-adapter": "./dist/src/runtime/authAdapter.js",
    "./upload": "./dist/src/runtime/upload/index.js",
    "./hooks": "./dist/src/runtime/hooks/index.js",
    "./react": "./dist/src/runtime/react/index.js",
    "./default-ui": "./dist/src/runtime/react/default-ui/index.js",
    "./list-params": "./dist/src/runtime/listParams.js",
    "./routes": "./dist/src/runtime/routes.js",
    "./routes/upload.astro": "./src/routes/upload.astro",
    "./routes/library.astro": "./src/routes/library.astro",
    "./routes/object/[id].astro": "./src/routes/object/[id].astro",
    "./routes/presets.astro": "./src/routes/presets.astro",
    "./routes/admin/media.astro": "./src/routes/admin/media.astro",
    "./middleware": "./dist/src/middleware.js",
    "./internal-server": "./dist/src/runtime/api/internal.server.js",
    "./compatibility": "./dist/src/runtime/compatibility.js"
  },
  "types": "./dist/src/integration.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:registry",
    "build:registry": "node scripts/build-registry.mjs",
    "preview:dev": "vite --config fixtures/preview/vite.config.ts",
    "preview:build": "tsc -p fixtures/preview/tsconfig.json --noEmit && vite build --config fixtures/preview/vite.config.ts",
    "verify:fleet-gates": "node scripts/verify-fleet-gates.mjs",
    "verify:registry-consumer": "node scripts/verify-registry-consumer.mjs",
    "verify:registry-drift": "node scripts/verify-registry-drift.mjs",
    "verify:starter-routes": "node scripts/verify-starter-routes.mjs",
    "verify:tarball-install": "node scripts/verify-tarball-install.mjs",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mano8/astro-ui-m8": "^1.5.0"
  },
  "peerDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@mano8/astro-auth-m8": "^2.2.0",
    "@tanstack/react-query": "^5.101.1",
    "astro": "^7.0.9",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/react": "^6.0.1",
    "@astrojs/starlight": "^0.41.3",
    "@eslint-react/eslint-plugin": "^5.18.0",
    "@eslint/js": "^10.0.1",
    "@mano8/astro-auth-m8": "^2.2.0",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-table": "^8.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.9",
    "astro": "^7.0.9",
    "eslint": "^10.8.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.9",
    "zod": "^4.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "mediaServiceM8": {
    "contract": "media-service-m8@1.1",
    "testedServiceVersion": "2.0.0",
    "serviceVersionRange": ">=2.0.0 <3.0.0"
  }
}
